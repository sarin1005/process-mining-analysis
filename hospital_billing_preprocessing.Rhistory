# Hospital Billing Event Log Preprocessing
#
# Purpose:
# Convert and enrich an academic hospital billing XES event log for
# process mining analysis in Apromore.
#
# Important:
# Activity durations, role assignments and hourly rates are assumptions.
# Cost outputs are indicative and are not actual hospital expenditure.

library(xesreadR)
library(dplyr)
library(xesreadR)
library(dplyr)
library(lubridate)
library(readr)

# 1. Load the XES log (suppress internal warnings from xesreadR) 
log_raw <- suppressWarnings(read_xes("Hospital Billing.xes")) 

# 2. Convert to plain data.frame (avoids tibble/eventlog quirks)
log <- as.data.frame(log_raw)

# 3. Standardize column names (all lowercase for consistency)
colnames(log) <- tolower(colnames(log))

# 4. Rename key columns to consistent names
log <- log %>%
rename(
case_id   = case_concept_name,  # trace identifier
activity  = activity_id,        # activity label
timestamp = timestamp           # event timestamp
)

# 5. Define assumed activity durations (minutes, NHS-informed baseline)
durations <- c(
"NEW" = 10,
"FIN" = 20,
"RELEASE" = 30,
"CODE OK" = 3,        # AI-assisted coding assumption (~3 min)
"CODE NOK" = 3,
"CODE ERROR" = 5,
"CHANGE DIAGN" = 15,
"BILLED" = 10,
"REOPEN" = 20,
"DELETE" = 5,
"EMPTY" = 5,
"SET STATUS" = 5,
"REJECT" = 10,
"STORNO" = 15,
"MANUAL" = 8,
"JOIN-PAT" = 15,
"CHANGE END" = 10,
"ZDBC_BEHAN" = 20
)
default_duration <- 10

# 6. Map activities to functional roles
role_map <- c(
"NEW" = "Admin",
"RELEASE" = "Admin",
"FIN" = "Insurance Officer",
"CODE OK" = "Medical Coder",
"CODE NOK" = "Medical Coder",
"CODE ERROR" = "Medical Coder",
"CHANGE DIAGN" = "Medical Coder",
"BILLED" = "Billing Specialist",
"STORNO" = "Billing Specialist",
"MANUAL" = "Supervisor",
"REOPEN" = "Supervisor",
"DELETE" = "System",
"REJECT" = "Admin",
"EMPTY" = "System",
"SET STATUS" = "System",
"JOIN-PAT" = "Admin",
"CHANGE END" = "System",
"ZDBC_BEHAN" = "Specialist"
)

# 7. Hourly rates per role (AUD)
role_rates <- c(
"Admin" = 30,
"Insurance Officer" = 40,
"Medical Coder" = 38,
"Billing Specialist" = 45,
"Supervisor" = 65,
"Specialist" = 67,
"System" = 0,
"Default" = 35
)

# 8. Enrich log with durations, roles, and cost
log_enriched <- log %>%
mutate(
end_time = as.POSIXct(timestamp, format="%Y-%m-%dT%H:%M:%OS", tz = "UTC"),
proc_minutes = ifelse(activity %in% names(durations),
durations[activity],
default_duration),
start_time = end_time - minutes(proc_minutes),
role = ifelse(activity %in% names(role_map), role_map[activity], "Default"),
hourly_rate = ifelse(role %in% names(role_rates),
role_rates[role],
role_rates["Default"]),
costAUD = (proc_minutes / 60) * hourly_rate
)

# 9. Preserve useful case attributes
case_attributes <- c("casetype","diagnosis","speciality","iscancelled","isclosed",
"actorange","actred","blocked","closecode","msgcode",
"msgcount","msgtype","version")
for(attr in case_attributes) {
if(attr %in% colnames(log) & !(attr %in% colnames(log_enriched))) {
log_enriched[[attr]] <- log[[attr]]
}
}

# 10. Export enriched CSV
write_csv(log_enriched, "Hospital_Billing_Enriched.csv")
